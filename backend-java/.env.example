# Spring Boot local profile
SPRING_PROFILES_ACTIVE=default
JWT_SECRET=change-this-jwt-secret-to-32-plus-bytes-change-this-now
ML_PREDICT_URL=http://localhost:8000/predict
LOCAL_UPLOAD_DIR=uploads

# Local database (H2)
DB_URL=jdbc:h2:file:./forensic-db;MODE=MySQL;DATABASE_TO_LOWER=TRUE
DB_USER=sa
DB_PASS=
DB_DRIVER=org.h2.Driver

# AWS profile placeholders (optional until deployment)
AWS_REGION=us-east-1
S3_BUCKET=replace-me

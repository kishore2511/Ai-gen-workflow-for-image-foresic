# Java backend
DB_URL=jdbc:h2:file:./forensic-db;MODE=MySQL;DATABASE_TO_LOWER=TRUE
DB_USER=sa
DB_PASS=
DB_DRIVER=org.h2.Driver
JWT_SECRET=change-this-jwt-secret-to-32-plus-bytes-change-this-now
ML_PREDICT_URL=http://localhost:8000/predict
LOCAL_UPLOAD_DIR=uploads

# Optional AWS profile values (enable with SPRING_PROFILES_ACTIVE=aws)
S3_BUCKET=your-s3-bucket
AWS_REGION=us-east-1

# Python service
PYTHONUNBUFFERED=1
